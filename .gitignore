# =========================================================================
# Git Ignore Configuration: Jenkins-Based RTI Request Tracking System
# =========================================================================

# --- Compiled Java / Maven Build Artifacts ---
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# --- Spring Boot & Application Runtime Logs ---
logs/
*.log
*.log.*
spring.log

# --- Local Uploads & Test Media Directory ---
uploads/
/var/rti/uploads/
scratch/
test-output/

# --- IDE & Editor Configuration Files ---
# JetBrains IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

# Antigravity & AI Agent Artifacts / Internal Caches
.gemini/
.agents/
.system_generated/
*.tmp
*.bak

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# --- Environment & Secret Files (Never commit credentials) ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.keystore
id_rsa
id_rsa.pub

# --- Docker & Local Database Mounts ---
.docker/
mysql-data/
docker-compose.override.yml

# --- Testing & Coverage Reports ---
.nyc_output/
coverage/
jacoco/
surefire-reports/
