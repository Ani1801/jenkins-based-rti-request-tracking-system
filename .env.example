# =========================================================================
# Environment Variables Template: RTI Request Tracking System (MVP-13)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' prior to running Docker Compose:
#      cp .env.example .env                  (Linux/macOS)
#      Copy-Item .env.example .env           (Windows PowerShell)
# 2. Replace all placeholder values with secure, environment-specific credentials.
# 3. WARNING: Never commit '.env' or secret-bearing credential files to Git.
# =========================================================================

# Database Name and Application Credentials
DB_NAME=rti_db
DB_USER=rti_user
DB_PASSWORD=CHANGE_ME_IN_ENV_USER_PASSWORD

# MySQL Root Administrative Password
DB_ROOT_PASSWORD=CHANGE_ME_IN_ENV_ROOT_PASSWORD

# Public Ingress HTTP Port for Nginx (Default: 80)
NGINX_PORT=80
